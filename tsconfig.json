{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["vite/client"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "CodeLuna.ts",
    "bots/**/*.ts",
    "gui/**/*.ts",
    "main/**/*.ts",
    "player/**/*.ts",
    "test/**/*.ts",
    "tutorial.ts"
  ]
}
